# Variables à copier dans Vercel (Production + Preview)

SECRET_KEY=change-me-generate-a-long-random-string
DEBUG=false

DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[MOT_DE_PASSE]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DIRECT_DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[MOT_DE_PASSE]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require

# Ne pas mettre pgbouncer=true dans l'URL (incompatible avec psycopg / Django)

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optionnel — rate limit partagé (Upstash Redis)
# Obligatoire sur Vercel (rate limit global, fail-closed)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_ALLOW_MEMORY=1
